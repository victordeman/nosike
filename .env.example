# Copy to .env.local for local development. Never commit real values.

# Canonical site origin (no trailing slash). Drives canonical URLs, sitemap and OG images.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact form delivery (server-only; never exposed to the browser)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Optional: shared rate-limit store (Upstash Redis REST). Falls back to an in-memory limiter.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: per-IP contact rate limit override (default 5 per 10 minutes).
CONTACT_RATE_LIMIT_MAX=
